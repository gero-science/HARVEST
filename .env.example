

LLM_KEY = "your_api_key_here"
LLM_URL = "https://openrouter.ai/api/v1"
# Examples: "qwen/qwen3-235b-a22b-2507" / "google/gemini-2.5-flash"
LLM_MODEL = "google/gemini-2.5-flash"
LLM_TEMPERATURE = 0

# OpenRouter specific settings
LLM_PROVIDER_SORT = "price"  # Options: price, throughput
LLM_PROVIDER_QUANTIZATIONS = ""  # Options: bf16, fp16, int8, int4 (comma-separated)
LLM_PROVIDER_IGNORE = "siliconflow"  # Comma-separated list of providers to ignore/ban

# API retry configuration
LLM_API_RETRY_ATTEMPTS = 5  # Number of retry attempts for failed API calls
LLM_API_RETRY_DELAY = 1  # Initial delay in seconds between retries (uses exponential backoff)

# Async pipeline configuration
PIPELINE_MAX_WORKERS = 100  # Maximum number of concurrent workers for Agent 1
PIPELINE_QUEUE_SIZE = 200  # Maximum size of processing queues

# Protein postprocessing runs on its own model, separate from the extractor
# above, because it is a different task. Defaults to openai/gpt-5.1.
PROTEIN_LLM_MODEL = "openai/gpt-5.1"

# USPTO Open Data Portal (only needed to download patents)
# Request a free key at https://data.uspto.gov/apis/getting-started
USPTO_TOKEN = "your_uspto_api_key_here"

# Google Gemini API (direct)
USE_GOOGLE_DIRECT = False
GOOGLE_API_KEY = "your_google_api_key_here"
GOOGLE_API_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
GOOGLE_MODEL = "gemini-2.5-flash"